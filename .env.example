# URL base de la API backend
VITE_API_URL=https://api.plataforma.local/v1

# Webhooks de Visione Flow (uno por flujo).
# Formato: https://api.flow.visione-edge.com/api/webhooks/<id>/web
# Copiar la URL desde el nodo Webhook de cada flujo. Si queda vacía, esa acción muestra "flujo no conectado".

# Flujo 1 · Chat de contextualización (agente Coordinador)
VITE_WEBHOOK_CHAT_URL=
# Flujo 2 · Panel: confirmar / editar / eliminar
VITE_WEBHOOK_PANEL_ITEM_URL=
# Flujo 2b · Confirmar el resumen
VITE_WEBHOOK_CONFIRMAR_RESUMEN_URL=
# Flujo 4 · Omitir solución (workflow pendiente)
VITE_WEBHOOK_OMITIR_URL=
# Flujo 4 · Aceptar o rechazar sugerencia (workflow pendiente)
VITE_WEBHOOK_DECIDIR_SUGERENCIA_URL=
